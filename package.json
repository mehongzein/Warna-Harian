{
  "dependencies": {
    "@devvit/web": "^0.15.4",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "description": "Warna Harian — teka-teki campur warna harian untuk Reddit (Devvit Web).",
  "devDependencies": {
    "@devvit/cli": "^0.15.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "name": "warna-harian",
  "private": true,
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "deploy": "npm run build && devvit upload",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --config vite.config.ts",
    "dev:server": "vite build --config vite.server.config.ts --watch",
    "login": "devvit login",
    "playtest": "devvit playtest",
    "test:server": "tsx ./tests/server.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json"
  },
  "type": "module",
  "version": "0.0.1"
}
